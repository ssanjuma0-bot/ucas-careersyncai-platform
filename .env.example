# UCAS CareerSync AI — environment variables
# Copy this file to .env for local development (a real .env is never
# committed — see .gitignore). On Render, set these in the dashboard
# under your service's Environment tab.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Signs and verifies login sessions (JWT). Must be a long random string —
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Render's render.yaml is configured to auto-generate this for you.
JWT_SECRET=change-this-to-a-long-random-string-at-least-16-characters

# Used once, by `npm run seed:admin`, to create the first administrator
# account. Not needed at normal server runtime — only when you explicitly
# run the seed script. Safe to remove from your environment afterward.
FIRST_ADMIN_EMAIL=admin@ucas.edu.in
FIRST_ADMIN_PASSWORD=ChangeMe123!


# ---------------------------------------------------------------------------
# OPTIONAL — set only if you want the feature to actually work
# ---------------------------------------------------------------------------

# Port the server listens on. Render sets this automatically — you do not
# need to set it yourself on Render.
PORT=4000

# Restricts CORS to your real frontend origin in production. Leave unset
# (defaults to "*") when frontend and backend are served from the same
# origin, which is the default setup here (server.js serves both).
FRONTEND_ORIGIN=

# UCASION AI — real provider proxy, called from the backend so the API key
# never reaches the browser. Leave both unset and the app honestly reports
# "AI provider is not configured" instead of faking a response.
AI_PROVIDER=            # "gemini" or "openai"
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=                # optional override, e.g. gemini-2.0-flash / gpt-4o-mini

# Email — real SMTP (hand-rolled client, no library needed). All five must
# be set together or email sending stays honestly "not configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS — real Twilio REST API call. All three must be set together.
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=
